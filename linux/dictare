#!/usr/bin/env bash
# Push-to-talk dictation toggle for GNOME/Wayland.
#   dictare toggle   — start recording, or stop + transcribe + paste
#   dictare start | stop | cancel | status
set -uo pipefail

BASE="$HOME/.local/share/dictare"
PORT="${DICTARE_PORT:-8910}"
RUN="${XDG_RUNTIME_DIR:-/tmp}/dictare"
PIDFILE="$RUN/rec.pid"
WAV="$RUN/rec.wav"
CANCELLED="$RUN/cancelled.wav"
LASTFILE="$RUN/last.txt"
HISTORY="$BASE/history.jsonl"
TRANSCRIPTS="$BASE/transcripts"
AUDIO_ARCHIVE="$BASE/audio"
MAX_SECONDS="${DICTARE_MAX_SECONDS:-180}"
# Set DICTARE_KEEP_AUDIO=1 to also archive the recording next to the transcript.
KEEP_AUDIO="${DICTARE_KEEP_AUDIO:-0}"

mkdir -p "$RUN" "$TRANSCRIPTS"

notify() { # notify <urgency> <title> <body>
  command -v notify-send >/dev/null || return 0
  notify-send -a "Dictare" -u "$1" \
    -h "string:x-canonical-private-synchronous:dictare" \
    "$2" "${3:-}" >/dev/null 2>&1 || true
}

recording() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; }

start_recording() {
  rm -f "$WAV"
  if command -v pw-record >/dev/null; then
    pw-record --rate=16000 --channels=1 --format=s16 "$WAV" &
  elif command -v arecord >/dev/null; then
    arecord -q -f S16_LE -r 16000 -c 1 -t wav "$WAV" &
  else
    notify critical "Dictare" "Niciun tool de înregistrare (pw-record/arecord)."
    exit 1
  fi
  local pid=$!
  echo "$pid" > "$PIDFILE"
  notify low "🔴 Înregistrez…" "Apasă din nou hotkey-ul ca să oprești."
  # Safety net: never leave the microphone open forever.
  ( sleep "$MAX_SECONDS"
    [ "$(cat "$PIDFILE" 2>/dev/null)" = "$pid" ] && "$0" stop >/dev/null 2>&1
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

copy_to_clipboard() {
  # wl-copy forks a daemon that keeps owning the Wayland selection. That
  # ownership is the whole job — a short-lived setter loses the text on exit,
  # so there is no useful pure-Python fallback here.
  command -v wl-copy >/dev/null || return 1
  printf '%s' "$1" | wl-copy
  # Also the PRIMARY selection, so middle-click works as a manual fallback.
  printf '%s' "$1" | wl-copy --primary 2>/dev/null || true
}

# Keycodes: 29=LEFTCTRL 42=LEFTSHIFT 47=V. Ctrl+V is right for GUI text fields,
# but terminals bind paste to Ctrl+Shift+V — set DICTARE_PASTE_KEYS to switch.
PASTE_CTRL_V="29:1 47:1 47:0 29:0"
PASTE_CTRL_SHIFT_V="29:1 42:1 47:1 47:0 42:0 29:0"
case "${DICTARE_PASTE:-auto}" in
  terminal) PASTE_KEYS="$PASTE_CTRL_SHIFT_V" ;;
  gui)      PASTE_KEYS="$PASTE_CTRL_V" ;;
  *)        PASTE_KEYS="${DICTARE_PASTE_KEYS:-$PASTE_CTRL_V}" ;;
esac

paste_it() {
  command -v ydotool >/dev/null || return 1
  # Let the compositor settle on the new selection owner before pasting.
  sleep 0.15
  # shellcheck disable=SC2086
  ydotool key $PASTE_KEYS >/dev/null 2>&1
}

selftest() {
  local fail=0
  chk() { # chk <label> <command...>
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then printf '  \033[32mOK\033[0m    %s\n' "$label"
    else printf '  \033[31mFAIL\033[0m  %s\n' "$label"; fail=1; fi
  }
  echo "dictare selftest"
  chk "whisper daemon răspunde"      curl -s --max-time 3 "http://127.0.0.1:$PORT/health"
  chk "wl-copy instalat"             command -v wl-copy
  chk "ydotool instalat"             command -v ydotool
  chk "ydotoold socket există"       test -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.ydotool_socket"
  chk "push-to-talk daemon rulează"  pgrep -f pttd.py
  chk "microfon disponibil"          command -v pw-record
  chk "clipboard scrie+citește"      bash -c 'printf ăîșț | wl-copy && [ "$(wl-paste -n)" = "ăîșț" ]'
  chk "ydotool poate injecta"        ydotool key 29:1 29:0

  echo
  if [ "$fail" -ne 0 ]; then
    echo "Ceva e picat mai sus — nu are rost testul de paste."
    return 1
  fi

  local marker="DICTARE_TEST_ăîșț_$(date +%H%M%S)"
  printf '%s' "$marker" | wl-copy
  echo "Test de paste: dă click într-un câmp de text (editor, browser, orice)."
  notify normal "Test paste în 5s" "Click într-un câmp de text ACUM"
  for i in 5 4 3 2 1; do printf '\r  injectez Ctrl+V în %ss… ' "$i"; sleep 1; done
  printf '\r  injectez acum…              \n'
  paste_it
  echo
  echo "Ar fi trebuit să apară textul:  $marker"
  echo "Dacă a apărut -> auto-paste funcționează."
  echo "Dacă NU a apărut dar e în clipboard (Ctrl+V manual merge) -> problema e doar injecția."
}

archive() { # archive <text> <daemon-json>
  local text="$1" resp="$2" day; day="$(date +%Y-%m-%d)"

  # One JSON line per dictation — greppable, and safe for text with newlines.
  jq -nc --arg ts "$(date --iso-8601=seconds)" --arg text "$text" \
        --argjson audio "$(printf '%s' "$resp" | jq '.audio // 0')" \
        --argjson took  "$(printf '%s' "$resp" | jq '.took  // 0')" \
        '{ts:$ts, text:$text, audio:$audio, took:$took}' >> "$HISTORY"

  # One markdown file per day, for reading back.
  printf '### %s\n%s\n\n' "$(date +%H:%M:%S)" "$text" >> "$TRANSCRIPTS/$day.md"

  if [ "$KEEP_AUDIO" = "1" ]; then
    mkdir -p "$AUDIO_ARCHIVE"
    cp -f "${CURRENT_WAV:-$WAV}" "$AUDIO_ARCHIVE/$(date +%Y-%m-%d_%H-%M-%S).wav"
  fi
}

deliver_wav() { # deliver_wav <path> — transcribe, save, copy, paste
  local wav="$1"
  CURRENT_WAV="$wav"
  if [ ! -s "$wav" ]; then
    notify normal "Dictare" "Nu s-a înregistrat nimic."
    exit 0
  fi

  notify low "⏳ Transcriu…" ""
  local resp text
  resp="$(curl -s --max-time 300 -X POST --data-binary "@$wav" \
          "http://127.0.0.1:$PORT/transcribe")"
  if [ -z "$resp" ]; then
    notify critical "Dictare" "Daemonul nu răspunde. systemctl --user status dictare"
    exit 1
  fi

  text="$(printf '%s' "$resp" | jq -r '.text // empty')"
  if [ -z "$text" ]; then
    notify normal "Dictare" "Nu am înțeles nimic."
    exit 0
  fi

  printf '%s' "$text" > "$LASTFILE"
  archive "$text" "$resp"
  if ! copy_to_clipboard "$text"; then
    notify critical "Lipsește wl-clipboard" "Textul e în: $LASTFILE"
    exit 1
  fi
  if paste_it; then
    notify low "✅ ${text:0:120}" ""
  else
    notify normal "📋 Copiat — apasă Ctrl+V" "${text:0:120}"
  fi
}

stop_and_transcribe() {
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null)"
  kill -INT "$pid" 2>/dev/null
  # Give the recorder a moment to flush the WAV header.
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
  kill -KILL "$pid" 2>/dev/null
  rm -f "$PIDFILE"
  deliver_wav "$WAV"
}

case "${1:-toggle}" in
  toggle) if recording; then stop_and_transcribe; else start_recording; fi ;;
  start)  recording || start_recording ;;
  stop)   recording && stop_and_transcribe ;;
  cancel) if recording; then kill -KILL "$(cat "$PIDFILE")" 2>/dev/null
            rm -f "$PIDFILE"
            # Keep the audio: an accidental abort must stay recoverable.
            [ -s "$WAV" ] && mv -f "$WAV" "$CANCELLED"
            notify normal "Dictare" "Anulat — 'dictare redo' îl procesează."; fi ;;
  redo)   newest=""
          for f in "$CANCELLED" "$WAV"; do
            [ -s "$f" ] || continue
            if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest="$f"; fi
          done
          [ -n "$newest" ] || { echo "nicio înregistrare de reprocesat" >&2; exit 1; }
          echo "reprocesez $newest"
          deliver_wav "$newest" ;;
  status) if recording; then echo "recording"; else
            curl -s --max-time 3 "http://127.0.0.1:$PORT/health" || echo "daemon down"
          fi ;;
  last)   cat "$LASTFILE" 2>/dev/null ;;
  history) jq -r '"\(.ts)  \(.text)"' "$HISTORY" 2>/dev/null | tail -"${2:-20}" ;;
  today)  cat "$TRANSCRIPTS/$(date +%Y-%m-%d).md" 2>/dev/null ;;
  selftest) selftest ;;
  *)      echo "usage: dictare {toggle|start|stop|cancel|status|last|history [n]|today|redo|selftest}" >&2; exit 2 ;;
esac
