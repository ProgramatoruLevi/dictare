[Unit]
Description=Dictare — faster-whisper dictation daemon (model resident in RAM)
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/share/dictare/venv/bin/python %h/.local/share/dictare/whisperd.py
Environment=DICTARE_MODEL=large-v3-turbo
Environment=DICTARE_LANG=ro
Environment=DICTARE_BEAM=5
Environment=DICTARE_THREADS=16
Environment=DICTARE_PORT=8910
Environment=OMP_NUM_THREADS=16
Restart=on-failure
RestartSec=5
Nice=-5

[Install]
WantedBy=default.target
