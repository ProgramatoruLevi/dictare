<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.levi.dictare-ptt</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/dictare/venv/bin/python</string>
    <string>__HOME__/.local/share/dictare/pttd_mac.py</string>
    <string>--key</string><string>cmd_r</string>
    <string>--hold-ms</string><string>250</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/share/dictare/pttd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/dictare/pttd.log</string>
</dict>
</plist>
